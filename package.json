{
  "name": "bazarstore",
  "version": "1.0.0",
  "description": "Hugo placeholder website for Bazarstore LLC and bazarstore.biz.",
  "private": true,
  "scripts": {
    "build:css": "postcss assets/tailwind/input.css -o assets/css/extended/custom.css",
    "dev": "npm run build:css && sh scripts/hugo.sh server --bind 127.0.0.1 --port 1313 --buildDrafts --cacheDir \"$PWD/resources/_gen\"",
    "build": "npm run build:css && sh scripts/hugo.sh --gc --minify --cacheDir \"$PWD/resources/_gen\"",
    "build:clean": "npm run build:css && sh scripts/hugo.sh --cleanDestinationDir --ignoreCache --gc --minify --cacheDir \"$PWD/resources/_gen\" --noBuildLock"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glove-puppet-dev/Bazarstore.git"
  },
  "keywords": [
    "hugo",
    "papermod",
    "tailwindcss",
    "netlify"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/glove-puppet-dev/Bazarstore/issues"
  },
  "homepage": "https://github.com/glove-puppet-dev/Bazarstore#readme",
  "devDependencies": {
    "@tailwindcss/postcss": "4.3",
    "postcss": "^8.5.15",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "4.3"
  }
}
